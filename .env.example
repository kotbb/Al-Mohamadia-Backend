# MongoDB connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=10m
JWT_REFRESH_EXPIRES_IN=21d

# Frontend Url PDF/WhatsApp links 
FRONTEND_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate limits (requests per 1 minute, per client IP)
THROTTLE_DISABLED=false
THROTTLE_AUTH_LIMIT=10
THROTTLE_GLOBAL_LIMIT=300


